global:
  scrape_interval: 1s
  evaluation_interval: 1s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: flow-control
    metrics_path: /actuator/prometheus
    static_configs:
      - targets:
%{ for ip in app_ips ~}
          - ${ip}:8081
%{ endfor ~}
  - job_name: mock-target-system
    metrics_path: /actuator/prometheus
    static_configs:
      - targets:
          - ${mock_ip}:9101
          - ${mock_ip}:9102
          - ${mock_ip}:9103
