        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(flow_control_outbound_latency_seconds_bucket{target=\"$target\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "B"
